{
  "name": "Chem_Log",
  "version": "1.0.1",
  "main": "./build/electron/main.js",
  "scripts": {
    "dump": "dump-stlite-desktop-artifacts",
    "serve": "cross-env NODE_ENV=production electron .",
    "app:dir": "electron-builder --dir",
    "app:dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Melissa A. Hines",
  "license": "MIT",
  "build": {
    "files": [
      "build/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "appId": "com.hinesLab.chem-log",
    "productName": "Chem Log",
    "mac": {
      "icon": "./assets/icons/mac/icon.icon",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "buildResources/entitlements.mac.plist",
      "entitlementsInherit": "buildResources/entitlements.mac.plist"
    },
    "afterSign": "./assets/notarize.js",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/pc/icon.ico"
    }
  },
  "devDependencies": {
    "@stlite/desktop": "^0.79.5",
    "cross-env": "^7.0.3",
    "electron": "34.3.0",
    "electron-builder": "^25.1.8"
  },
  "stlite": {
    "desktop": {
      "files": [
        "chemLogApp.py",
        "./.streamlit/secrets.toml",
        "./assets/icon.png"
      ],
      "requirementsTxtFiles": [
        "requirements.txt"
      ],
      "entrypoint": "chemLogApp.py"
    }
  }
}
